{
  "name": "spfx-employee-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Employee Dashboard web part for SharePoint Framework, with a standalone demo harness.",
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "start": "heft start --clean",
    "eject-webpack": "heft eject-webpack",
    "dev": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json"
  },
  "dependencies": {
    "tslib": "2.3.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2"
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/webpack-env": "~1.15.2",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "~5.8.0",
    "@vitejs/plugin-react": "4.7.0",
    "sass": "1.83.4",
    "vite": "5.4.19"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
